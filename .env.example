# ─────────────────────────────────────────────────────────────────────────────
# BITAGENTS environment configuration
#
# Copy this file to `.env.local` at the repo root and fill in values.
# The demo works with ZERO paid APIs — every key below is optional except
# TREASURY_WALLET (only needed if you want to take real devnet payments).
# ─────────────────────────────────────────────────────────────────────────────

# ── Solana network ───────────────────────────────────────────────────────────
# Default read network shown in the UI: "devnet" (Devnet Demo Mode) or "mainnet"
# (Mainnet Read Mode). Payments and signed transactions ALWAYS run on devnet for
# safety, regardless of this value. Mainnet is used for read-only data only.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoints. Public defaults are used when these are blank.
NEXT_PUBLIC_DEVNET_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com

# ── Treasury (devnet) ────────────────────────────────────────────────────────
# Devnet wallet that receives task fees (0.001 SOL). Generate one with:
#   solana-keygen new --no-bip39-passphrase --outfile treasury.json
#   solana address -k treasury.json
# Leave blank to disable payments — the app then runs every task as a free demo.
TREASURY_WALLET=

# ── Optional LLM providers ───────────────────────────────────────────────────
# If none are set, agents use deterministic local report generation.
# Ollama (free, local). Start with: `ollama run llama3.1`
OLLAMA_BASE_URL=
# Override the Ollama model (defaults to llama3.1).
OLLAMA_MODEL=llama3.1
# OpenAI (optional, paid).
OPENAI_API_KEY=
# Anthropic (optional, paid).
ANTHROPIC_API_KEY=

# ── Local JSON database ──────────────────────────────────────────────────────
# Where providers/tasks are stored. Defaults to ./.data at the repo root locally,
# and to the OS temp dir on Vercel/Lambda (ephemeral — see README limitations).
BITAGENTS_DATA_DIR=

# ── Optional remote provider worker (workers/provider-worker) ────────────────
# Not required: agent compute runs server-side in the Next.js app. The worker
# only demonstrates a remote provider joining the marketplace via heartbeat.
API_BASE_URL=http://localhost:3000
PROVIDER_WALLET=REPLACE_WITH_DEVNET_PROVIDER_WALLET
PROVIDER_NAME=remote-worker-01
PROVIDER_COMPUTE_TYPE=CPU
PROVIDER_PRICE_SOL=0.001
PROVIDER_ENDPOINT=
HEARTBEAT_INTERVAL_MS=30000
