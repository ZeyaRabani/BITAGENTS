# Solana DCA Agent - copy to .env and fill in values
#   cp .env.example .env

# ─── Zero-setup notification channels (user-experiments branch) ──────────────
# One shared platform credential per channel -- users never enter a key,
# they only confirm ownership of a destination via a real test-send.
# Free tier: resend.com (3,000 emails/month, 100/day).
RESEND_API_KEY=
RESEND_FROM=BITAGENTS <alerts@bitagents.app>
# Free: create via @BotFather in Telegram, no cost at any volume.
TELEGRAM_BOT_TOKEN=

# ─── CapIX LLM (primary) ──────────────────────────────────────────────────────
# OpenAI-compatible chat API — https://www.capix.network/api/v1/chat/completions
CAPIX_API_KEY=
CAPIX_API_URL=https://www.capix.network/api/v1/chat/completions
CAPIX_MODEL=meta-llama/llama-3.1-8b-instruct
# Pin upstream provider so CapIX does not route tool calls to mistral-nemo
CAPIX_PROVIDER=DeepInfra
# CAPIX_MAX_RETRIES=5
# CAPIX_CONNECT_TIMEOUT=15
# CAPIX_READ_TIMEOUT=120

# ─── Self-hosted Ollama (optional fallback) ───────────────────────────────────
# Used only when CAPIX_API_KEY is unset
# HOSTED_OLLAMA_URL=https://llm.bitagents.app
# HOSTED_OLLAMA_CONNECT_TIMEOUT=15
# HOSTED_OLLAMA_READ_TIMEOUT=120
# HOSTED_OLLAMA_MODEL=llama3.2:3b
# HOSTED_MODEL_API_KEY=

# ─── OpenRouter (optional fallback) ───────────────────────────────────────────
# Used when neither CapIX nor hosted Ollama keys are set
# OPEN_ROUTER_API=
# OPEN_ROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# OPEN_ROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPEN_ROUTER_SITE_URL=https://your-frontend-domain.com
# OPEN_ROUTER_APP_NAME=BIT Agents
# DCA_MODEL=meta-llama/llama-3.1-8b-instruct

# ─── Solana network ───────────────────────────────────────────────────────────
# devnet: scheduled SOL transfers (Jupiter unavailable)
# mainnet: real Jupiter token swaps + deposit verification
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet example:
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── Wallet (required for live transactions) ────────────────────────────────
# Base58 secret key OR JSON byte array from `solana-keygen new --outfile key.json`
# Never commit this file with a real key.
DCA_WALLET_PRIVATE_KEY=

# Optional alias (used if DCA_WALLET_PRIVATE_KEY is empty)
# SOLANA_PRIVATE_KEY=

# ─── Internal API key (shared with Next.js proxy) ─────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value in frontend/.env as AGENTS_INTERNAL_API_KEY
AGENTS_INTERNAL_API_KEY=

# ─── Wallet session auth ──────────────────────────────────────────────────────
# Public URL for legal links embedded in wallet sign-in messages
# BITAGENTS_PUBLIC_URL=https://your-frontend-domain.com
# DCA_SESSION_TTL_HOURS=24
# DCA_CHALLENGE_TTL_MINUTES=10

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Connection string from https://console.neon.tech (include ?sslmode=require)
DATABASE_URL=
# ─── Agent options ────────────────────────────────────────────────────────────
# How often the background scheduler checks for due DCA buys (seconds)
DCA_SCHEDULER_POLL_SECONDS=30

# Legacy JSON paths - only used for one-time import when DB tables are empty
# DCA_PLANS_FILE=./dca_plans.json
# DCA_DEPOSITS_FILE=./user_deposits.json

# ─── Local HTTP API (frontend integration) ────────────────────────────────────
# Run unified server: python agents_api.py  (legacy: python dca_api.py)
# Local defaults; on Render, PORT is injected and host becomes 0.0.0.0 automatically
AGENTS_API_HOST=127.0.0.1
AGENTS_API_PORT=8765

# Comma-separated browser origins allowed by CORS (plus localhost:3000 by default)
CORS_ALLOW_ORIGINS=https://bitagents.app, https://www.bitagents.app

# ─── Shared in-memory cache (15 minutes, per API process) ─────────────────────
# Token Research + Due Diligence share token:profile:* ; Wallet uses wallet:snapshot:*
TOKEN_RESEARCH_CACHE_TTL_SECONDS=900
WALLET_MONITORING_CACHE_TTL_SECONDS=900

# Optional separate model for EasyA Analysis Agent (defaults to DCA_MODEL / CAPIX_MODEL)
# KICKSTART_COPILOT_MODEL=meta-llama/llama-3.1-8b-instruct

# ─── EasyA Analysis Agent trading wallet (Jupiter buys, separate from DCA) ───
# Base58 or JSON byte array — users deposit SOL here for market/limit orders
EASYA_ANALYSIS_AGENT_WALLET_PRIVATE_KEY=
# EASYA_ORDER_POLL_SECONDS=30
# EASYA_THRESHOLD_CHECK_SECONDS=900

# ─── EASY Screener (EasyA Analysis Agent token data) ──────────────────────────
# Get a key at https://easyscreener.xyz - send as Authorization: Bearer header
EZ_API_KEY=
# Aliases also supported: EASY_SCREENER_API_KEY, EZSCREENER_API_KEY
# EASY_SCREENER_API_URL=https://easyscreener.xyz/api/public/v1
# EZSCREENER_BASE_URL=https://easyscreener.xyz/api/public/v1
# EASY_SCREENER_CACHE_TTL_SECONDS=3600

# Jupiter API endpoints (defaults are fine for most users)
# JUPITER_QUOTE_API=https://quote-api.jup.ag/v6/quote
# JUPITER_SWAP_API=https://quote-api.jup.ag/v6/swap

# ─── Volume Agent (Meteora DLMM volume campaigns) ─────────────────────────────
# Separate wallet for DLMM pool creation + scheduled buy/sell volume
VOLUME_AGENT_WALLET_PRIVATE_KEY=
# METEORA_POOL_CREATION_SOL=0.02669
# VOLUME_PLATFORM_FEE_RATE=0.0025
# VOLUME_SCHEDULER_POLL_SECONDS=30
# VOLUME_MODEL=meta-llama/llama-3.1-8b-instruct
# METEORA_DLMM_API=https://dlmm-api.meteora.ag
# METEORA_DEFAULT_BIN_STEP=80
# METEORA_DEFAULT_FEE_BPS=25
