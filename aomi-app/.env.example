# Used by local `aomi-run` against the Python strategy API.
# Production Aomi credentials are configured in the Aomi Developer Platform / user credentials UI.

# HTTPS origin in production. Local dual-server testing may use loopback HTTP.
BITAGENTS_API_URL=http://127.0.0.1:8765/
# Must match agent/new/.env AGENTS_INTERNAL_API_KEY
BITAGENTS_INTERNAL_API_KEY=
# Wallet session from POST /auth/verify after signing in on the Next.js app
BITAGENTS_SESSION_TOKEN=

# Optional LLM for aomi-run (pick one provider when you launch)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
