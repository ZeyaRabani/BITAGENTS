# BITAGENTS MVP runs on Solana devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Create a devnet wallet for the treasury and paste the public key here.
# The web app sends user task fees to this address.
NEXT_PUBLIC_TREASURY_PUBLIC_KEY=REPLACE_WITH_DEVNET_TREASURY_PUBLIC_KEY

# Optional: provide a treasury secret key to let the API send payouts directly.
# Supports a JSON array from `solana-keygen new --outfile treasury.json` or a bs58 secret key.
TREASURY_SECRET_KEY=

# Local JSON database path. Defaults to ./.data/bitagents.json at repo root.
BITAGENTS_DATA_DIR=

# Provider worker settings.
API_BASE_URL=http://localhost:3000
PROVIDER_WALLET=REPLACE_WITH_REGISTERED_PROVIDER_WALLET
PROVIDER_NAME=Local BITAGENTS Provider
POLL_INTERVAL_MS=4000

# Yield Agent protocol APIs live in agent/new/.env (see agent/new/.env.example).
# Kamino (no key): https://kamino.com/build/api-reference/introduction
# Save (no key): https://docs.save.finance/developers/introduction
# Drift data API: https://docs.drift.trade/developers/data-api
# MarginFi SDK (no REST API): https://docs.marginfi.com/ts-sdk
