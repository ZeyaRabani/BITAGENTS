# ─────────────────────────────────────────────────────────────────────────────
# BITAGENTS DCA Agent — environment configuration
#
# Copy this file to `.env.local` at the repo root and fill in values.
# The app runs with ZERO paid APIs: the NL parser has a deterministic fallback,
# Devnet Demo Mode simulates executions, and Mainnet Safe Mode uses Jupiter's
# free "lite" Recurring API (no key required).
# ─────────────────────────────────────────────────────────────────────────────

# ── Network & feature flags ──────────────────────────────────────────────────
# Default read/UI network. This deployment defaults to "mainnet" (Mainnet Safe
# Mode). Set to "devnet" to default the UI to Devnet Demo Mode instead.
NEXT_PUBLIC_DEFAULT_NETWORK=mainnet

# Allow real Jupiter Recurring (mainnet) orders. Defaults to true on this
# deployment. Set to false to force the UI into Devnet Demo Mode (the Mainnet
# Safe toggle is then disabled).
NEXT_PUBLIC_ENABLE_MAINNET_DCA=true

# Experimental Agent Wallet Mode (server-scheduled swaps from an encrypted,
# server-held key). DISABLED by default; only enable for allowlisted test users.
NEXT_PUBLIC_ENABLE_AGENT_WALLET_MODE=false
ENABLE_AGENT_WALLET_MODE=false

# RPC endpoints. Public defaults are used when blank.
NEXT_PUBLIC_DEVNET_RPC=https://api.devnet.solana.com
# Public mainnet-beta 403s browser requests; PublicNode is keyless + browser-friendly.
# Swap in a dedicated RPC (Helius/QuickNode/Triton) for production reliability.
NEXT_PUBLIC_MAINNET_RPC=https://solana-rpc.publicnode.com

# ── BITAGENTS token ──────────────────────────────────────────────────────────
# Real, routeable mint (Meteora DAMM v2, 6 decimals). Override for other tokens.
NEXT_PUBLIC_BITAGENTS_MINT=iu3A7azWTm3zQSk81SUC1JctB4zPYnxLmcmqq71EASY
NEXT_PUBLIC_BITAGENTS_SYMBOL=BITAGENTS

# ── Jupiter Recurring API ────────────────────────────────────────────────────
# Leave blank to use the free "lite" host (https://lite-api.jup.ag, no key).
# Set JUPITER_API_KEY to use the pro host (https://api.jup.ag) automatically,
# or pin a host explicitly with JUPITER_API_BASE.
JUPITER_API_KEY=
JUPITER_API_BASE=

# ── Optional LLM providers (NL parsing) ──────────────────────────────────────
# If none are set, the deterministic regex parser handles the common prompts.
# Tried in order: OpenRouter -> Ollama -> OpenAI -> Anthropic -> deterministic.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Scheduler ────────────────────────────────────────────────────────────────
# Secures /api/cron/dca. Set this in production (Vercel Cron sends it as a
# Bearer token). Leave blank locally to run the cron endpoint unauthenticated.
CRON_SECRET=

# ── Database backend ─────────────────────────────────────────────────────────
# Pick ONE. If none are set, a local JSON file is used (dev default).
#   * Upstash Redis REST (serverless-safe, recommended for Vercel):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#   * Postgres (documented extension point; no driver bundled — falls back to JSON):
DATABASE_URL=
# Local JSON store location. Defaults to ./.data locally, OS temp dir on Vercel.
BITAGENTS_DATA_DIR=

# ── Experimental Agent Wallet Mode caps (only used when enabled) ─────────────
MAX_AGENT_WALLET_TOTAL_SOL=0.05
MAX_AGENT_WALLET_ORDERS=5
MIN_INTERVAL_SECONDS=60
# 32-byte key (base64 or hex) used to AES-256-GCM encrypt agent wallet secrets.
AGENT_WALLET_ENCRYPTION_KEY=
# Comma-separated wallet addresses allowed to use agent wallet mode.
AGENT_WALLET_ALLOWED_USERS=

# ── Local DCA worker (npm run dca:worker) ────────────────────────────────────
# Polls /api/cron/dca so Devnet Demo plans advance while developing locally.
BASE_URL=http://localhost:3000
INTERVAL_MS=10000
